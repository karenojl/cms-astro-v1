---
import AposArea from "@apostrophecms/apostrophe-astro/components/AposArea.astro";
import { HomePageView } from "@/templates/react/HomePageView";

const { page, user, query } = Astro.props.aposData;
const { main } = page;
const isEditMode = Boolean(query?.["apos-edit"]);
---

<HomePageView title={page.title} isLoggedIn={Boolean(user)} {isEditMode}>
  <AposArea area={main} />
</HomePageView>
