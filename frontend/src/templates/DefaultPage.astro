---
import AposArea from "@apostrophecms/apostrophe-astro/components/AposArea.astro";
import { DefaultPageView } from "@/templates/react/DefaultPageView";

const { page } = Astro.props.aposData;
const { main } = page;
---

<DefaultPageView title={page.title}>
  <AposArea area={main} />
</DefaultPageView>
