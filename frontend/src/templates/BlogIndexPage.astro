---
import setParameter from "@apostrophecms/apostrophe-astro/lib/aposSetQueryParameter.js";
import { BlogIndexPageView } from "@/templates/react/BlogIndexPageView";
import type { AposPieceData } from "@/types/apos";

const {
  page,
  pieces = [],
  currentPage = 1,
  totalPages = 1,
} = Astro.props.aposData as {
  page: { title?: string };
  pieces?: AposPieceData[];
  currentPage?: number;
  totalPages?: number;
};

const pagination = Array.from({ length: totalPages }, (_, index) => ({
  number: index + 1,
  current: index + 1 === currentPage,
  url: setParameter(Astro.url, "page", index + 1),
}));
---

<BlogIndexPageView
  title={page.title}
  pieces={pieces.map((piece, index) => ({
    id: piece._id ?? piece._url ?? `${piece.title ?? "piece"}-${index}`,
    title: piece.title,
    url: piece._url,
    publishedAt: piece.publishedAt,
  }))}
  {pagination}
/>
