---
import AposArea from "@apostrophecms/apostrophe-astro/components/AposArea.astro";
import { BlogShowPageView } from "@/templates/react/BlogShowPageView";

const { piece } = Astro.props.aposData;
const { main } = piece;
---

<BlogShowPageView title={piece.title} publishedAt={piece.publishedAt}>
  <AposArea area={main} />
</BlogShowPageView>
