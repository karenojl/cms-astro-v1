---
import AposArea from "@apostrophecms/apostrophe-astro/components/AposArea.astro";
import { getAreaOrNull } from "@/lib/apos";
import { HeroWidgetView } from "@/widgets/react/HeroWidgetView";
import type { HeroWidgetData } from "@/types/widgets";

interface Props {
  widget?: HeroWidgetData;
}

const { widget = {} } = Astro.props as Props;
const bodyArea = getAreaOrNull(widget.body);
---

<HeroWidgetView label={widget.label} sublabel={widget.sublabel}>
  {bodyArea && <AposArea area={bodyArea} />}
</HeroWidgetView>
