---
import { FileWidgetView } from "@/widgets/react/FileWidgetView";
import type { FileWidgetData } from "@/types/widgets";

interface Props {
  widget?: FileWidgetData;
}

const { widget = {} } = Astro.props as Props;
const file = widget._file?.[0];
---

<FileWidgetView href={file?._url} title={file?.title ?? undefined} />
