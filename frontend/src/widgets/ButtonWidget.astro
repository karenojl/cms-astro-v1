---
import { ButtonWidgetView } from "@/widgets/react/ButtonWidgetView";
import type { ButtonWidgetData, ButtonWidgetViewProps } from "@/types/widgets";

interface Props {
  widget?: ButtonWidgetData;
}

const { widget = {} } = Astro.props as Props;
const label = widget.label || widget.title || widget.text || "Button";
const href = widget.url || widget.href || widget.linkHref;
const unsafeVariant = widget.variant || widget.style || "primary";
const variant: ButtonWidgetViewProps["variant"] = ["primary", "secondary", "text"].includes(unsafeVariant)
  ? (unsafeVariant as ButtonWidgetViewProps["variant"])
  : "primary";
const target = widget.openInNewTab || widget.target === "_blank" ? "_blank" : undefined;
const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<ButtonWidgetView label={label} href={href} variant={variant} target={target} rel={rel} />
