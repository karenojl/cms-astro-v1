---
import AposArea from "@apostrophecms/apostrophe-astro/components/AposArea.astro";
import { getAreaOrNull } from "@/lib/apos";
import { SlideshowWidgetView } from "@/widgets/react/SlideshowWidgetView";
import type { SlideshowWidgetData } from "@/types/widgets";

interface Props {
  widget?: SlideshowWidgetData;
}

const { widget = {} } = Astro.props as Props;
const slidesArea = getAreaOrNull(widget.slides);
---

<SlideshowWidgetView hasSlides={Boolean(slidesArea)}>
  {slidesArea && <AposArea area={slidesArea} />}
</SlideshowWidgetView>
